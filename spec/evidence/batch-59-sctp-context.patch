+func ExampleResolveSCTPAddrContext() {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	addr, err := sctp.ResolveSCTPAddrContext(ctx, "sctp4", "127.0.0.1/127.0.0.2:3868")
